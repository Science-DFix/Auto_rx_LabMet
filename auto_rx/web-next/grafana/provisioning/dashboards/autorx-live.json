{
  "id": null,
  "uid": "autorx-live-eval",
  "title": "auto_rx - Avaliação Gráfica (tempo real)",
  "tags": ["auto_rx"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "sonde_id",
        "type": "query",
        "label": "Sonde",
        "refresh": 2,
        "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "autorx-history-bridge" },
        "query": {
          "queryType": "infinity",
          "type": "json",
          "source": "url",
          "url": "http://127.0.0.1:4500/sondes",
          "root_selector": "",
          "format": "table",
          "parser": "backend"
        },
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Altitude x Tempo",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "lengthm" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "autorx-history-bridge" },
          "type": "json",
          "source": "url",
          "url": "http://127.0.0.1:4500/history/${sonde_id}",
          "root_selector": "",
          "format": "table",
          "parser": "backend",
          "columns": [
            { "selector": "time", "text": "Time", "type": "timestamp_epoch" },
            { "selector": "alt", "text": "Altitude (m)", "type": "number" }
          ]
        }
      ]
    },
    {
      "id": 2,
